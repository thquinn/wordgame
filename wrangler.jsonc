{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wordgame-rooms",
  "main": "server/index.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" }
  }
}
